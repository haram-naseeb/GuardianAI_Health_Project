# GuardianAI Location Agent configuration.
# Copy this file to .env and fill in real values.
# NEVER commit .env or put real keys in code, logs, or tests.

# Google Maps Platform API key.
# Required APIs: Places API (Nearby Search) and Directions API.
GOOGLE_MAPS_API_KEY=

# Development / demo mode: use clearly marked fake facilities instead of
# calling Google Maps. Never mix mock output with production responses.
LOCATION_AGENT_MOCK=true

# Optional overrides (defaults shown).
# LOCATION_SEARCH_RADIUS_M=10000
# LOCATION_MAX_FACILITIES=10
# LOCATION_REQUEST_TIMEOUT_S=10
